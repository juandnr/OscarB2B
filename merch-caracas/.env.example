# Copia este archivo a .env (no lo subas al repositorio) y define las mismas
# variables en el contenedor de n8n. Los comentarios van en su propia línea.

# ── 360dialog ──
D360_API_KEY=
# Texto largo al azar; n8n rechaza los webhooks que no lo traen.
D360_WEBHOOK_SECRET=
# URL del webhook de F1 en n8n (solo la usa scripts/configurar-webhook-360dialog.js).
# Ej.: https://n8n.tudominio.com/webhook/merch-caracas/whatsapp
D360_WEBHOOK_URL=

# ── HubSpot ──
HUBSPOT_PRIVATE_APP_TOKEN=
# El pipeline y los IDs de etapa los imprime `npm run hubspot:setup`.
HUBSPOT_PIPELINE_ID=
HUBSPOT_ETAPA_NUEVO=
HUBSPOT_ETAPA_SOLICITUD=
HUBSPOT_ETAPA_COTIZADO=
HUBSPOT_ETAPA_VERIFICAR_PAGO=
HUBSPOT_ETAPA_PAGADO=
HUBSPOT_ETAPA_LISTO_PARA_ENVIAR=
HUBSPOT_ETAPA_ENVIADO=
HUBSPOT_ETAPA_ENTREGADO=
HUBSPOT_ETAPA_PERDIDO=
# Usuario de HubSpot que recibe los escalamientos (F3) y el resumen diario (F5).
ADMIN_HUBSPOT_OWNER_ID=

# ── Claude ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high. Ajustar según la revisión del modo sombra.
ANTHROPIC_EFFORT=low
# "default" = si el modelo rechaza la solicitud, la API la reintenta con otro modelo. "no" lo desactiva.
ANTHROPIC_FALLBACK=default

# ── Postgres ──
# Con docker-compose.yml la llena deploy/preparar.sh (host "postgres", base "merch").
DATABASE_URL=

# ── Reglas ──
TIMEZONE=America/Caracas
# PENDIENTE (Oscar). Formato: lun-vie 08:00-17:00; sab 08:00-12:00
HORARIO_LABORAL=
# Opcional. Días sin horario laboral: 2026-12-24,2026-12-25
FERIADOS=
DEBOUNCE_MIN=5
SLA_RESPUESTA_NUEVO_MIN=15
SLA_RESPUESTA_CURSO_MIN=120
SLA_SEGUIMIENTO_HORAS=48
ESCALAR_MIN=60
# true = F2 solo escribe resumen_ia y una nota. false = mueve etapas y crea tareas.
MODO_SOMBRA=true
# Clientes que analiza F2 en cada corrida.
F2_LOTE=8

# ── Solo en el contenedor de n8n ──
# Los Code nodes leen esta configuración con $env.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Tiempo máximo de un Code node (F2 analiza varios chats por corrida).
N8N_RUNNERS_TASK_TIMEOUT=300

# ── Servidor (docker-compose.yml) ──
# Los llena deploy/preparar.sh. N8N_ENCRYPTION_KEY no se puede cambiar después:
# con otra clave n8n ya no puede leer las credenciales guardadas.
N8N_DOMINIO=
POSTGRES_USER=
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
